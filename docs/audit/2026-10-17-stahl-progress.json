  "completed": [
    {
      "scope": "Real atom-plus-density identity for distinct real diagonal directions",
      "declaration": "NLAlib.exists_exterior_branches_integral_real_circleDensity_eq_traceExp_sub_atoms",
      "read_back": "For Hermitian A and injective real diagonal slopes, construct one exterior branch family. For any fixed circle outside the common disk, the contour density is real; its exponentially weighted integral is integrable on each compact interval containing the slopes and equals traceExp(A-t diag b) minus the explicit atomic exponential sum for every real t. No density positivity is claimed."
    },
    {
      "scope": "General Hermitian simple-spectrum coefficient, complex density",
      "declaration": "NLAlib.exists_exterior_branches_integral_circleDensity_eq_trace_matrixExp_sub_atoms_of_isHermitian",
      "read_back": "Unitary diagonalization transports the fixed-circle transform identity to any Hermitian coefficient with injective eigenvalues, with no commutation condition on A."
    },
    {
      "scope": "Eigenvalue branches near infinity",
      "declaration": "NLAlib.exists_exterior_eigenvalue_branches_sub_real_diagonal",
      "read_back": "Construct all branches of A-z diag b outside a common disk with holomorphy, complete distinct spectral values and affine asymptotes. An analytic reciprocal remainder also gives O(1/z)."
    },
    {
      "scope": "Real sign mechanism",
      "declaration": "NLAlib.neg_sum_integral_exp_mul_deriv_nonneg",
      "read_back": "Integration by parts gives a nonnegative boundary contribution for finite smooth chains whose heights and phase derivatives satisfy the specified signs. Internal endpoint terms cancel, permitting corners. The actual spectral boundary is not constructed."
    },
    {
      "scope": "Compactness of positive representations",
      "declaration": "NLAlib.exists_finiteMeasure_exp_mul_eq_of_tendsto",
      "read_back": "Pointwise limits of positive finite exponential representations on a common compact interval retain one such measure for every real parameter; convergence at zero provides the mass bound."
    },
    {
      "scope": "Commuting Hermitian pencils",
      "declaration": "NLAlib.exists_isCompactExpRepresentation_traceExp_of_commute",
      "read_back": "Construct the positive finite atomic representing measure on the direction spectral interval for commuting Hermitian A,H, including empty dimensions and repeated eigenvalues."
    },
    {
      "scope": "Mass and derivative consequences once a positive measure is constructed",
      "declaration": "NLAlib.IsCompactExpRepresentation.iteratedDeriv_eq_integral",
      "read_back": "Compact support supplies real analyticity, total mass F(0), all tilted-moment derivative identities, even-derivative nonnegativity and the sharp endpoint exponential bounds."
    },
    {
      "scope": "Separated root-sum holomorphy with multiplicities",
      "declaration": "Polynomial.analyticAt_sum_filter_roots_upper_of_upperHemicontinuous",
      "read_back": "A root-free circle and analytic polynomial coefficients give the actual enclosed-root sum analytically, retaining collisions and algebraic multiplicities. Spectral upper hemicontinuity and a tangent circle select the upper roots locally."
    },
    {
      "scope": "Actual inverse-contour bridge",
      "declaration": "NLAlib.eventually_circleDensity_eq_neg_circleIntegral_of_exterior_inverse_branches",
      "read_back": "For the same actual forward and inverse branches, the fixed-circle density equals the negative normalized exponential moment on one common large inverse circle. Same-label inversion, pullback, free-loop homotopy, orientations, and integration by parts are proved."
    },
    {
      "scope": "Nonnegative density for noncommuting Hermitian pencils",
      "declaration": "NLAlib.traceExponentialCircleDensity_re_nonneg_of_exterior_branches",
      "read_back": "The exact density is nonnegative for every real s away from the finite slope set. The proof constructs the upper-root sum, proves its imaginary part nonnegative and its uniform bounds, and deforms through smooth thin ellipses."
    },
    {
      "scope": "Full positive-measure theorem and derivative consequences",
      "declaration": "NLAlib.exists_isCompactExpRepresentation_traceExp_with_derivatives",
      "read_back": "For arbitrary finite Hermitian A,H, construct one finite positive Borel measure concentrated on [lambdaMin H,lambdaMax H] representing traceExp(A+t H) for every real t, with mass traceExp A, all tilted-moment derivatives and both spectral-endpoint bounds on even derivatives. Repeated eigenvalues, scalar directions, and dimension zero are covered."
    }
  ],
