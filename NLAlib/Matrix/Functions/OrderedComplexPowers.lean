import NLAlib.Matrix.Functions.ComplexCalculus
import NLAlib.Matrix.Functions.OrderedExponential
import NLAlib.Matrix.Norms.SchattenComparison
import NLAlib.Matrix.Norms.SchattenContinuity

/-!
# Ordered complex powers and positive scalar regularization

The displayed order of the factors is preserved. Fixed Hermitian eigenbases
prove continuity at singular PSD inputs without selecting moving eigenvectors.
Source: Sutter--Berta--Tomamichel, arXiv:1604.03023v3, Theorem 3.2.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
open Matrix Complex
open scoped Matrix.Norms.L2Operator MatrixOrder ComplexOrder
namespace NLAlib

variable {n : Type*} [Fintype n] [DecidableEq n]

private theorem matrix_norm_one_le : ‖(1 : Matrix n n ℂ)‖ ≤ 1 := by
  cases isEmpty_or_nonempty n with
  | inl h =>
    let := h
    have hz : (1 : Matrix n n ℂ) = 0 := Subsingleton.elim _ _
    simp [hz]
  | inr h =>
    let := h
    simp

/-- The actual ordered product of principal matrix complex powers. -/
def orderedMatrixComplexPower (L : List (Matrix n n ℂ)) (z : ℂ) : Matrix n n ℂ :=
  (L.map (fun A => matrixComplexPower A z)).prod

@[simp] theorem orderedMatrixComplexPower_nil (z : ℂ) :
    orderedMatrixComplexPower ([] : List (Matrix n n ℂ)) z = 1 := rfl

@[simp] theorem orderedMatrixComplexPower_cons (A : Matrix n n ℂ)
    (L : List (Matrix n n ℂ)) (z : ℂ) :
    orderedMatrixComplexPower (A :: L) z =
      matrixComplexPower A z * orderedMatrixComplexPower L z := rfl

/-- Positive definite complex powers are the ordered exponential family
generated by the individual matrix logarithms. -/
theorem orderedMatrixComplexPower_eq_orderedMatrixExp_log
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosDef) (z : ℂ) :
    orderedMatrixComplexPower L z = orderedMatrixExp (L.map matrixLog) z := by
  unfold orderedMatrixComplexPower orderedMatrixExp
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro A hA
  exact matrixComplexPower_eq_matrixExp_smul_log (hL A hA) z

/-- At real exponents, an ordered PSD complex-power product is precisely
the product of the native positive real CFC powers.
atlas: multivariate-araki-lieb-thirring (partial) -/
theorem orderedMatrixComplexPower_ofReal_eq_prod_rpow
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosSemidef) (r : ℝ) :
    orderedMatrixComplexPower L (r : ℂ) = (L.map (fun A => CFC.rpow A r)).prod := by
  unfold orderedMatrixComplexPower
  congr 1
  apply List.map_congr_left
  intro A hA
  exact matrixComplexPower_ofReal_eq_rpow (hL A hA) r

/-- All logarithms generating the positive definite ordered family are
Hermitian. -/
theorem isHermitian_mem_map_matrixLog (L : List (Matrix n n ℂ)) :
    ∀ H ∈ L.map matrixLog, H.IsHermitian := by
  intro H hH
  obtain ⟨A, _, rfl⟩ := List.mem_map.mp hH
  exact cfc_predicate Real.log A

/-- Complex powers on the right boundary are uniformly controlled by the
product of the original PSD operator norms. Empty products are included. -/
theorem norm_orderedMatrixComplexPower_right_le
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosSemidef) (t : ℝ) :
    ‖orderedMatrixComplexPower L (1 + (t : ℂ) * I)‖ ≤ (L.map (fun A => ‖A‖)).prod := by
  induction L with
  | nil => simpa using (matrix_norm_one_le (n := n))
  | cons A L ih =>
    rw [orderedMatrixComplexPower_cons, List.map_cons, List.prod_cons]
    exact (norm_mul_le _ _).trans (mul_le_mul
      (norm_matrixComplexPower_le_of_re_eq_one (hL A (by simp)) (by simp))
      (ih (fun B hB => hL B (by simp [hB]))) (norm_nonneg _ ) (norm_nonneg _))

/-- The right-boundary ordered complex product is continuous even for
singular PSD factors. -/
theorem continuous_orderedMatrixComplexPower_right
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosSemidef) :
    Continuous (fun t : ℝ => orderedMatrixComplexPower L (1 + (t : ℂ) * I)) := by
  induction L with
  | nil => exact continuous_const
  | cons A L ih =>
    exact (continuous_matrixComplexPower_right (hL A (by simp))).mul
      (ih (fun B hB => hL B (by simp [hB])))

/-- Adding the same real scalar identity to every factor preserves their
displayed order. -/
def regularizeMatrixList (L : List (Matrix n n ℂ)) (ε : ℝ) : List (Matrix n n ℂ) :=
  L.map (fun A => A + (ε : ℂ) • (1 : Matrix n n ℂ))

omit [Fintype n] in
@[simp] theorem regularizeMatrixList_zero (L : List (Matrix n n ℂ)) :
    regularizeMatrixList L 0 = L := by simp [regularizeMatrixList]

omit [Fintype n] in
/-- Positive regularization gives genuine positive definite inputs. -/
theorem posDef_mem_regularizeMatrixList (L : List (Matrix n n ℂ))
    (hL : ∀ A ∈ L, A.PosSemidef) {ε : ℝ} (hε : 0 < ε) :
    ∀ A ∈ regularizeMatrixList L ε, A.PosDef := by
  intro A hA
  obtain ⟨B, hB, rfl⟩ := List.mem_map.mp hA
  exact posDef_add_ofReal_smul_one (hL B hB) hε

omit [Fintype n] in
/-- Nonnegative scalar regularization preserves PSD inputs. -/
theorem posSemidef_mem_regularizeMatrixList (L : List (Matrix n n ℂ))
    (hL : ∀ A ∈ L, A.PosSemidef) {ε : ℝ} (hε : 0 ≤ ε) :
    ∀ A ∈ regularizeMatrixList L ε, A.PosSemidef := by
  intro A hA
  obtain ⟨B, hB, rfl⟩ := List.mem_map.mp hA
  exact (hL B hB).add (Matrix.PosSemidef.one.smul (by exact_mod_cast hε))

/-- The entire ordered product converges to the original product as the
scalar regularization tends to zero, for every exponent of positive real part. -/
theorem continuousAt_orderedMatrixComplexPower_regularize
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.IsHermitian)
    {z : ℂ} (hz : 0 < z.re) :
    ContinuousAt (fun ε : ℝ => orderedMatrixComplexPower (regularizeMatrixList L ε) z) 0 := by
  induction L with
  | nil => exact continuousAt_const
  | cons A L ih =>
    exact (continuousAt_matrixComplexPower_add_ofReal_smul_one (hL A (by simp)) hz).mul
      (ih (fun B hB => hL B (by simp [hB])))

/-- A common operator norm bound for scalar regularizations with `0≤ε≤1`,
uniform in imaginary time. -/
theorem norm_orderedMatrixComplexPower_regularize_right_le
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosSemidef)
    {ε : ℝ} (hε : ε ∈ Set.Icc (0 : ℝ) 1) (t : ℝ) :
    ‖orderedMatrixComplexPower (regularizeMatrixList L ε) (1 + (t : ℂ) * I)‖ ≤
      (L.map (fun A => ‖A‖ + 1)).prod := by
  apply (norm_orderedMatrixComplexPower_right_le _
    (posSemidef_mem_regularizeMatrixList L hL hε.1) t).trans
  unfold regularizeMatrixList
  rw [List.map_map]
  apply List.prod_map_le_prod_map₀ _ _ (fun _ _ => norm_nonneg _)
  intro A hA
  have hn : ‖A + (ε : ℂ) • (1 : Matrix n n ℂ)‖ ≤ ‖A‖ + 1 := by
    apply (norm_add_le _ _).trans
    apply add_le_add le_rfl
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hε.1]
    exact (mul_le_mul_of_nonneg_left matrix_norm_one_le hε.1).trans (by simpa using hε.2)
  exact hn

/-- Right-boundary Schatten norms have a fixed bound for all positive scalar
regularizations up to one. -/
theorem schattenNormReal_orderedMatrixComplexPower_regularize_right_le
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosSemidef)
    {p ε : ℝ} (hp : 0 < p) (hε : ε ∈ Set.Icc (0 : ℝ) 1) (t : ℝ) :
    schattenNormReal (orderedMatrixComplexPower (regularizeMatrixList L ε)
      (1 + (t : ℂ) * I)) p ≤
        (Fintype.card n : ℝ) ^ (1 / p) * (L.map (fun A => ‖A‖ + 1)).prod := by
  apply (schattenNormReal_le_card_rpow_mul_specNorm _ hp).trans
  exact mul_le_mul_of_nonneg_left
    (norm_orderedMatrixComplexPower_regularize_right_le L hL hε t)
    (Real.rpow_nonneg (Nat.cast_nonneg _) _)

/-- A fixed uniform Schatten bound for an unregularized PSD ordered family. -/
theorem schattenNormReal_orderedMatrixComplexPower_right_le
    (L : List (Matrix n n ℂ)) (hL : ∀ A ∈ L, A.PosSemidef)
    {p : ℝ} (hp : 0 < p) (t : ℝ) :
    schattenNormReal (orderedMatrixComplexPower L (1 + (t : ℂ) * I)) p ≤
      (Fintype.card n : ℝ) ^ (1 / p) * (L.map (fun A => ‖A‖ + 1)).prod := by
  simpa only [regularizeMatrixList_zero] using
    schattenNormReal_orderedMatrixComplexPower_regularize_right_le L hL hp
      (show (0 : ℝ) ∈ Set.Icc 0 1 by constructor <;> norm_num) t

end NLAlib
